---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
const base = import.meta.env.BASE_URL;

const featured = projects.filter((project) => project.featured);
const techStack = [
  { category: 'FRONT END', items: [ { name: 'React', icon: 'react' }, { name: 'HTML5', icon: 'html' }, { name: 'CSS3', icon: 'css' }, { name: 'JavaScript', icon: 'js' }, { name: 'TypeScript', icon: 'ts' } ] },
  { category: 'BACK END & OTHER LANGUAGES', items: [ { name: 'Node.js', icon: 'nodejs' }, { name: 'FastAPI', icon: 'fastapi' }, { name: 'Python', icon: 'python' }, { name: 'Java', icon: 'java' }, { name: 'C++', icon: 'cpp' }, { name: 'C', icon: 'c' } ] },
  { category: 'DATABASE', items: [ { name: 'MySQL', icon: 'mysql' }, { name: 'PostgreSQL', icon: 'postgres' }, { name: 'MongoDB', icon: 'mongodb' } ] },
  { category: 'ROBOTICS & OTHER', items: [ { name: 'ROS 2', icon: 'ros' }, { name: 'Raspberry Pi', icon: 'raspberrypi' }, { name: 'Arduino', icon: 'arduino' }, { name: 'OpenCV', icon: 'opencv' }, { name: 'Git', icon: 'git' }, { name: 'Docker', icon: 'docker' }, { name: 'Linux', icon: 'linux' } ] }
];
const achievements = [
  { rank: 'Runner-up', event: 'IEEE INSL Idea Stage 2025', image: '/images/Achievements/IENSL Runnersup.png' },
  { rank: 'Top 50', event: 'SPARK Competition' },
  { rank: 'Finalist', event: 'YARL Geek Challenge S14', image: '/images/Achievements/Finalist Yarl Geek Challenge.png' },
  { rank: 'Participant', event: 'Sri Lanka Robotics Challenge 2025', image: '/images/Achievements/SLRC_Participation.jpeg' },
];
const leadership = [
  { role: 'Programme Committee', org: 'Hit the Ground Tournament', image: '/images/Leadership & Service/Hit The Ground.png' },
  { role: 'Logistics Committee', org: 'SLIoT Competition', image: '/images/Leadership & Service/SLIOT.png' },
  { role: 'Religious Coordinator', org: 'Majlis-Ul-Islam', image: '/images/Leadership & Service/Religious coordinator.png' },
  { role: 'Logistics & Marketing', org: 'Career Fair 26', image: '/images/Leadership & Service/carrierfare.jpeg' },
];
---
<BaseLayout>
  <Hero />

  <section class="section white" id="about">
    <div class="shell">
      <h2 class="about-main-title">About Me</h2>

      <div class="about-layout-grid">
        <div class="about-text-col">
          <h3 class="about-greeting">Hello! I'm Abdul Rafi.</h3>
          <p class="about-para">I'm a Computer Science & Engineering undergraduate at the University of Moratuwa, specializing in Integrated Computer Engineering, with a strong interest in software engineering, robotics, and AI & computer vision.</p>
          <p class="about-para">I have hands-on experience building full-stack platforms, ROS 2 robotics systems, and computer-vision pipelines — from a production school management system to autonomous navigation on humanoid and mobile robots.</p>
        </div>

        <div class="about-photo-col">
          <div class="about-photo-card" data-tilt data-lightbox-trigger="/images/abdul-rafi-about.png" data-lightbox-title="Abdul Rafi — Computer Science & Engineering" data-lightbox-badge="About">
            <img src="/images/abdul-rafi-about.png" alt="Abdul Rafi delivering a keynote address" loading="lazy" class="about-portrait-img" />
          </div>
        </div>
      </div>

      <div class="stats">
        <div class="stat"><strong data-count="7" data-suffix="">0</strong><span>Engineering Projects</span></div>
        <div class="stat"><strong data-count="4" data-suffix="">0</strong><span>Achievements</span></div>
        <div class="stat"><strong data-count="4" data-suffix="">0</strong><span>Leadership Roles</span></div>
        <div class="stat"><strong data-count="2" data-suffix="+ yrs">0</strong><span>Experience</span></div>
      </div>
    </div>
  </section>

  <section class="section white" id="projects">
    <div class="shell">
      <SectionHeading center title="Projects" />
      <div class="project-grid">{featured.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
      <div class="projects-footer"><a class="button dark" href={`${base}projects`}>See all projects <Icon name="arrow" size={17} /></a></div>
    </div>
  </section>

  <section class="section" id="education">
    <div class="shell">
      <SectionHeading center title="Education" />
      <div class="education-list">
        <article class="education-item"><span class="date">Mar 2024 — Now</span><div><h3>University of Moratuwa</h3><p>B.Sc. Engineering (Hons.) in Computer Science & Engineering<br />Specialization in Integrated Computer Engineering</p></div><p class="result">CGPA 3.15 / 4.00<br />Sri Lanka</p></article>
        <article class="education-item"><span class="date">2009 — 2023</span><div><h3>St. Thomas’ College, Matara</h3><p>G.C.E. Advanced Level — Physical Science Stream<br />Combined Mathematics, Physics & Chemistry</p></div><p class="result">3 A grades · Island Rank 206<br />Z-Score 2.5139</p></article>
      </div>
    </div>
  </section>

  <section class="section tech-section" id="stack">
    <div class="shell">
      <h2 class="tech-section-title">Tech Stack & Software</h2>
      <div class="tech-stack-wrap">
        {techStack.map(section => (
          <div class="tech-category">
            <div class="category-header">
              <h4 class="category-title">{section.category}</h4>
              <div class="category-line"></div>
            </div>
            <div class="tech-grid">
              {section.items.map(item => (
                <div class="tech-card">
                  <img src={`https://skillicons.dev/icons?i=${item.icon}&theme=light`} alt={item.name} loading="lazy" />
                  <span>{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section white" id="recognition">
    <div class="shell">
      <!-- Achievements Horizontal Roll -->
      <div class="roll-block" id="achievements">
        <div class="roll-header-centered">
          <SectionHeading center title="Achievements" />
          <div class="roll-controls-row">
            <button class="roll-btn roll-prev" data-roll-prev="achievements-roll" aria-label="Previous achievement">&larr;</button>
            <button class="roll-btn roll-next" data-roll-next="achievements-roll" aria-label="Next achievement">&rarr;</button>
          </div>
        </div>
        <div class="roll-track-wrap" id="achievements-roll" data-roll-track>
          {achievements.map((item) => (
            <div class:list={['roll-card', { 'has-image': !!item.image }]} data-tilt data-lightbox-trigger={item.image} data-lightbox-title={`${item.rank} — ${item.event}`} data-lightbox-badge={`Achievement / ${item.rank}`}>
              <div class="roll-card-media">
                {item.image ? (
                  <img src={item.image} alt={item.event} loading="lazy" class="roll-card-img" />
                ) : (
                  <div class="roll-card-placeholder">
                    <span class="placeholder-icon">★</span>
                    <span class="placeholder-label">SPARK Competition</span>
                  </div>
                )}
                <div class="roll-media-overlay">
                  <span class="roll-view-badge">Expand Photo</span>
                </div>
              </div>
              <div class="roll-card-body">
                <span class="roll-badge">{item.rank}</span>
                <h4 class="roll-card-title kinetic-title">{item.event}</h4>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Leadership & Service Horizontal Roll -->
      <div class="roll-block" id="leadership" style="margin-top: 84px;">
        <div class="roll-header-centered">
          <SectionHeading center title="Leadership & Service" />
          <div class="roll-controls-row">
            <button class="roll-btn roll-prev" data-roll-prev="leadership-roll" aria-label="Previous leadership role">&larr;</button>
            <button class="roll-btn roll-next" data-roll-next="leadership-roll" aria-label="Next leadership role">&rarr;</button>
          </div>
        </div>
        <div class="roll-track-wrap" id="leadership-roll" data-roll-track>
          {leadership.map((item) => (
            <div class:list={['roll-card', { 'has-image': !!item.image }]} data-tilt data-lightbox-trigger={item.image} data-lightbox-title={`${item.role} — ${item.org}`} data-lightbox-badge={`Leadership / ${item.role}`}>
              <div class="roll-card-media">
                {item.image ? (
                  <img src={item.image} alt={item.org} loading="lazy" class="roll-card-img" />
                ) : (
                  <div class="roll-card-placeholder">
                    <span class="placeholder-icon">✦</span>
                  </div>
                )}
                <div class="roll-media-overlay">
                  <span class="roll-view-badge">Expand Photo</span>
                </div>
              </div>
              <div class="roll-card-body">
                <span class="roll-badge">{item.role}</span>
                <h4 class="roll-card-title kinetic-title">{item.org}</h4>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <script>
    // Horizontal Roll Control & Drag Script
    document.querySelectorAll('[data-roll-track]').forEach((trackEl) => {
      const track = trackEl as HTMLElement;
      let isDown = false;
      let startX = 0;
      let scrollLeft = 0;

      track.addEventListener('mousedown', (e) => {
        isDown = true;
        track.classList.add('dragging');
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
      });

      track.addEventListener('mouseleave', () => {
        isDown = false;
        track.classList.remove('dragging');
      });

      track.addEventListener('mouseup', () => {
        isDown = false;
        track.classList.remove('dragging');
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.8;
        track.scrollLeft = scrollLeft - walk;
      });
    });

    document.querySelectorAll('[data-roll-prev]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-roll-prev');
        const track = document.getElementById(targetId ?? '');
        if (track) {
          track.scrollBy({ left: -360, behavior: 'smooth' });
        }
      });
    });

    document.querySelectorAll('[data-roll-next]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-roll-next');
        const track = document.getElementById(targetId ?? '');
        if (track) {
          track.scrollBy({ left: 360, behavior: 'smooth' });
        }
      });
    });

    // Stats Counter Animation
    const counterElements = document.querySelectorAll<HTMLElement>('[data-count]');
    if (counterElements.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              const target = parseInt(el.getAttribute('data-count') || '0', 10);
              const suffix = el.getAttribute('data-suffix') || '';
              const duration = 1400;
              const startTime = performance.now();

              const step = (now: number) => {
                const elapsed = now - startTime;
                const progress = Math.min(elapsed / duration, 1);
                const easeOut = 1 - Math.pow(1 - progress, 3);
                const current = Math.floor(easeOut * target);
                el.textContent = `${current}${suffix}`;
                if (progress < 1) {
                  requestAnimationFrame(step);
                } else {
                  el.textContent = `${target}${suffix}`;
                }
              };
              requestAnimationFrame(step);
              observer.unobserve(el);
            }
          });
        },
        { threshold: 0.3 }
      );

      counterElements.forEach((el) => observer.observe(el));
    }
  </script>


  <section class="contact-section" id="contact">
    <div class="shell">
      <div class="connect-box">
        <h2 class="connect-main-title">Let's Connect</h2>
        <p class="connect-sub-title">Open to opportunities, collaborations, and conversations. Reach out via any of the channels below or send me a direct message.</p>

        <div class="connect-grid">
          <!-- Left Column: Reach Out -->
          <div class="connect-col-left">
            <div class="connect-section-tag">
              <span class="tag-line"></span>
              <span class="tag-text">REACH OUT</span>
            </div>
            <div class="connect-email-group">
              <span class="connect-label">EMAIL</span>
