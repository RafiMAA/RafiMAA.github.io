---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Curriculum Vitae — Abdul Rafi" description="View and download Abdul Rafi's curriculum vitae.">
  <section class="simple-page">
    <div class="shell">
      <div class="simple-header">
        <h1 class="simple-title">Curriculum Vitae</h1>
        <a class="button dark" href="/cv/Abdul_Rafi_CV.pdf" download>
          Download CV <Icon name="download" size={17} />
        </a>
      </div>
      <div class="cv-browser-frame">
        <div class="cv-browser-bar">
          <div class="cv-browser-dots">
            <span class="dot red"></span>
            <span class="dot yellow"></span>
            <span class="dot green"></span>
          </div>
          <span class="cv-browser-filename">Abdul_Rafi_CV.pdf</span>
        </div>
        <iframe class="cv-viewer" src="/cv/Abdul_Rafi_CV.pdf" title="CV preview"></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
